---
import Base from '@/layouts/Base.astro';
import '@/styles/v4.tokens.css';
import '@/styles/v4.css';
import { NAV, href, isCurrent } from '@/lib/site';
import type { PreloadAttrs } from '@/lib/image';
import type { SiteSettings } from '@/lib/types';

interface Props {
  settings: SiteSettings;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  preload?: PreloadAttrs;
  noindex?: boolean;
  /** Text for the fixed bottom-left corner (the series title); the counter follows the frames. */
  corner?: string;
  /** Pages with frames show the "i" control. */
  frames?: number;
}
const { settings, title, description, image, type, jsonLd, preload, noindex, corner, frames = 0 } = Astro.props;
const path = Astro.url.pathname;
---

<Base version="v4" {title} {description} siteName={settings.photographerName} {image} {type} {jsonLd} {preload} {noindex} fonts={['jost-variable.woff2', 'switzer-400.woff2']}>
  <a class="v4-corner v4-corner--tl" href={href('v4')}>{settings.photographerName}</a>
  <nav class="v4-corner v4-corner--tr" aria-label="Main">
    {NAV.map((n) => (
      <a href={href('v4', n.path)} aria-current={isCurrent(path, 'v4', n.path) ? 'page' : undefined}>{n.label}</a>
    ))}
  </nav>
  <main id="main">
    <slot />
  </main>
  {
    corner && (
      <p class="v4-corner v4-corner--bl">
        <span data-corner>{corner}</span>
        {frames > 0 && (
          <span aria-live="polite">
            <span data-count>01</span> / {String(frames).padStart(2, '0')}
          </span>
        )}
      </p>
    )
  }
  {
    frames > 0 && (
      <p class="v4-corner v4-corner--br">
        <button type="button" class="v4-info" aria-expanded="false" aria-keyshortcuts="i" data-info>Info</button>
      </p>
    )
  }
  <script>
    // Frame counter in the corner; "i" toggles metadata for every frame at once.
    const frames = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
    const count = document.querySelector<HTMLElement>('[data-count]');
    const title = document.querySelector<HTMLElement>('[data-corner]');
    if (frames.length && count) {
      const io = new IntersectionObserver(
        (es) =>
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            count.textContent = String(Number(el.dataset.frame) + 1).padStart(2, '0');
            if (title && el.dataset.title) title.textContent = el.dataset.title;
          }),
        { threshold: 0.55 },
      );
      frames.forEach((f) => io.observe(f));
    }
    const info = document.querySelector<HTMLButtonElement>('[data-info]');
    if (info) {
      const set = (on: boolean) => {
        document.body.classList.toggle('is-info', on);
        info.setAttribute('aria-expanded', String(on));
      };
      info.addEventListener('click', () => set(!document.body.classList.contains('is-info')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'i' && !(e.target instanceof HTMLInputElement)) set(!document.body.classList.contains('is-info'));
        if (e.key === 'Escape') set(false);
      });
    }
  </script>
</Base>
