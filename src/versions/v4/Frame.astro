---
/** One screen of the reel. `full` fills by hotspot; the rest sit on black. */
import Pic from '@/components/Pic.astro';
import { heightSizes, QUALITY } from '@/lib/image';
import type { Photo, Series } from '@/lib/types';
import { DISCIPLINE_LABEL } from '@/lib/types';

interface Props {
  photo: Photo;
  index: number;
  series?: Series;
  priority?: boolean;
  /** Title shown in the corner while this frame is in view (home: the series name). */
  title?: string;
}
const { photo, index, series, priority = false, title } = Astro.props;
const w = photo.displayWidth;
const sizes = w === 'full' ? '100vw' : heightSizes(photo, 88, w === 'wide' ? 86 : w === 'half' ? 60 : 42);
---

<section class:list={['cine', `cine--${w}`]} data-frame={index} data-title={title} aria-label={`Frame ${index + 1}`}>
  {w === 'full' ? <Pic photo={photo} sizes={sizes} fill priority={priority} quality={QUALITY.single} /> : <Pic photo={photo} sizes={sizes} class="cine__pic" priority={priority} quality={QUALITY.single} />}
  <dl class="cine__info">
    {photo.caption && (<><dt>Caption</dt><dd class="cine__caption">{photo.caption}</dd></>)}
    <dt>Description</dt><dd>{photo.alt}</dd>
    {series && (<><dt>Series</dt><dd>{series.title}, {series.year}, {DISCIPLINE_LABEL[series.discipline]}{series.location ? `, ${series.location}` : ''}</dd></>)}
    <dt>Frame</dt><dd>{index + 1}</dd>
  </dl>
</section>
