---
import Base from '@/layouts/Base.astro';
import '@/styles/v2.tokens.css';
import '@/styles/v2.css';
import { NAV, href, isCurrent } from '@/lib/site';
import type { PreloadAttrs } from '@/lib/image';
import type { SiteSettings } from '@/lib/types';

interface Props {
  settings: SiteSettings;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  preload?: PreloadAttrs;
  noindex?: boolean;
}
const { settings, title, description, image, type, jsonLd, preload, noindex } = Astro.props;
const path = Astro.url.pathname;
---

<Base version="v2" {title} {description} siteName={settings.photographerName} {image} {type} {jsonLd} {preload} {noindex} fonts={['jost-variable.woff2']}>
  <a class="v2-wordmark" href={href('v2')}>{settings.photographerName}</a>
  <nav class="v2-menu" aria-label="Main" data-menu>
    <button class="v2-menu__toggle" type="button" aria-expanded="false" aria-controls="v2-menu-list">Menu</button>
    <ul class="v2-menu__list" id="v2-menu-list">
      {NAV.map((n) => (
        <li>
          <a href={href('v2', n.path)} aria-current={isCurrent(path, 'v2', n.path) ? 'page' : undefined}>{n.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <main id="main">
    <slot />
  </main>
  <footer class="v2-foot">
    <a href={`mailto:${settings.email}`}>{settings.email}</a>
    {settings.instagram && <a href={`https://www.instagram.com/${settings.instagram}/`} rel="me">Instagram</a>}
  </footer>
  <script>
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    const toggle = menu?.querySelector<HTMLButtonElement>('button');
    if (menu && toggle) {
      const set = (open: boolean) => {
        menu.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Close' : 'Menu';
      };
      toggle.addEventListener('click', () => set(!menu.classList.contains('is-open')));
      document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
      document.addEventListener('click', (e) => !menu.contains(e.target as Node) && set(false));
    }
  </script>
</Base>
