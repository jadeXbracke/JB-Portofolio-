---
import Shell from '@/site/Shell.astro';
import { getSite } from '@/lib/cms';
const { settings, series } = await getSite();
---

<Shell {settings} {series} title="Not found" description="That page does not exist." noindex left={[{ label: 'Not found' }]}>
  <section class="plain">
    <p class="dim">That page does not exist. <a href="/" style="color: var(--white)">All images</a></p>
  </section>
</Shell>
