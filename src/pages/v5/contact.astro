---
import Shell from '@/versions/v5/Shell.astro';
import { getSite } from '@/lib/cms';
import { ogImageUrl } from '@/lib/image';
import { personLd } from '@/lib/jsonld';
const { settings } = await getSite();
---

<Shell {settings} title="Contact" description={`Commission ${settings.photographerName}: ${settings.email}. ${settings.availabilityNote ?? ''}`.trim()} image={ogImageUrl(settings.seoDefaults.ogImage)} jsonLd={[personLd(settings, Astro.site, Astro.url.toString())]}>
  <section class="v5-page">
    <aside class="v5-page__aside v5-mono">
      <h1>Contact</h1>
      {settings.availabilityNote && <p class="v5-dim">{settings.availabilityNote}</p>}
    </aside>
    <div class="v5-page__body">
      <a class="v5-email" href={`mailto:${settings.email}`}>{settings.email}</a>
      <dl class="v5-dl">
        {settings.phone && (<><dt>Phone</dt><dd><a href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a></dd></>)}
        {settings.instagram && (<><dt>Instagram</dt><dd><a href={`https://www.instagram.com/${settings.instagram}/`} rel="me">@{settings.instagram}</a></dd></>)}
        <dt>Commissions</dt><dd>Editorial, hospitality, interiors, portraits and still life. Prints to order.</dd>
      </dl>
    </div>
  </section>
</Shell>
