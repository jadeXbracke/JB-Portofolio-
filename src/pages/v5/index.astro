---
import Shell from '@/versions/v5/Shell.astro';
import Sheet from '@/versions/v5/Sheet.astro';
import { getArchive, getSite } from '@/lib/cms';
import { ogImageUrl, preloadAttrs, QUALITY } from '@/lib/image';
import { personLd } from '@/lib/jsonld';
import { DISCIPLINE_LABEL, type Discipline } from '@/lib/types';

const { settings, series } = await getSite();
const items = await getArchive();
const count = (key: (i: (typeof items)[number]) => string | number) => {
  const m = new Map<string | number, number>();
  for (const it of items) m.set(key(it), (m.get(key(it)) ?? 0) + 1);
  return m;
};
const years = [...count((i) => i.series.year)].sort((a, b) => Number(b[0]) - Number(a[0]));
const disciplines = [...count((i) => i.series.discipline)].sort((a, b) => String(a[0]).localeCompare(String(b[0])));
const bySeries = series.map((s) => [s, s.images.length] as const);
const first = items[0]?.photo;
---

<Shell {settings} title={settings.seoDefaults.title} description={settings.seoDefaults.description} image={ogImageUrl(settings.seoDefaults.ogImage ?? first)} preload={first ? preloadAttrs(first, '(min-width: 60em) 12vw, 33vw', QUALITY.grid) : undefined} jsonLd={[personLd(settings, Astro.site, Astro.url.toString())]}>
  <section class="archive">
    <aside class="meta v5-mono" data-filters aria-label="Filter the archive">
      <h1>{settings.photographerName}</h1>
      <p class="v5-dim">Archive</p>
      <p><span data-shown>{items.length}</span> / {items.length} frames</p>
      <button type="button" class="meta__toggle" aria-expanded="false" data-toggle>Filters</button>
      <div class="meta__group" role="group" aria-labelledby="f-year">
        <h2 id="f-year">Year</h2>
        {years.map(([y, n]) => (<button type="button" aria-pressed="false" data-filter="year" data-value={y}><span>{y}</span><span class="v5-dim">{n}</span></button>))}
      </div>
      <div class="meta__group" role="group" aria-labelledby="f-disc">
        <h2 id="f-disc">Discipline</h2>
        {disciplines.map(([d, n]) => (<button type="button" aria-pressed="false" data-filter="discipline" data-value={d}><span>{DISCIPLINE_LABEL[d as Discipline]}</span><span class="v5-dim">{n}</span></button>))}
      </div>
      <div class="meta__group" role="group" aria-labelledby="f-series">
        <h2 id="f-series">Series</h2>
        {bySeries.map(([s, n]) => (<button type="button" aria-pressed="false" data-filter="series" data-value={s.slug}><span>{s.title}</span><span class="v5-dim">{n}</span></button>))}
      </div>
      <button type="button" class="meta__clear" data-clear disabled>Clear filters</button>
    </aside>
    <Sheet {items} />
  </section>
  <script>
    // Filters: one value per group, AND across groups. Hidden cells are removed from the
    // grid flow (the sheet reflows; that is the state change).
    const root = document.querySelector<HTMLElement>('[data-filters]');
    const cells = [...document.querySelectorAll<HTMLElement>('[data-sheet] .cell')];
    if (root) {
      const state: Record<string, string | null> = { year: null, discipline: null, series: null };
      const shown = root.querySelector<HTMLElement>('[data-shown]');
      const clear = root.querySelector<HTMLButtonElement>('[data-clear]');
      const apply = () => {
        let n = 0;
        for (const c of cells) {
          const ok = Object.entries(state).every(([k, v]) => !v || c.dataset[k] === v);
          c.hidden = !ok;
          if (ok) n++;
          if (!ok) c.classList.remove('is-open');
        }
        if (shown) shown.textContent = String(n);
        root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(state[b.dataset.filter!] === b.dataset.value)));
        if (clear) clear.disabled = !Object.values(state).some(Boolean);
      };
      root.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (b) {
          const k = b.dataset.filter!;
          state[k] = state[k] === b.dataset.value ? null : b.dataset.value!;
          apply();
        }
      });
      const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
      toggle?.addEventListener('click', () => {
        const open = root.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      clear?.addEventListener('click', () => {
        for (const k of Object.keys(state)) state[k] = null;
        apply();
      });
    }
  </script>
</Shell>
