---
import Shell from '@/versions/v5/Shell.astro';
import { getSite } from '@/lib/cms';
import { ogImageUrl } from '@/lib/image';
import { href } from '@/lib/site';
import { DISCIPLINE_LABEL } from '@/lib/types';
const { settings, series } = await getSite();
const total = series.reduce((n, s) => n + s.images.length, 0);
---

<Shell {settings} title="Work" description={`Series by ${settings.photographerName}: ${series.map((s) => s.title).join(', ')}.`} image={ogImageUrl(series[0]?.cover)}>
  <div class="v5-table-wrap">
    <h1 class="v5-mono" style="padding-top: var(--space-4)">Series <span class="v5-dim">{series.length}, {total} frames</span></h1>
    <table class="v5-table">
      <thead>
        <tr><th class="v5-mono">Nº</th><th>Title</th><th class="v5-mono">Year</th><th>Discipline</th><th>Location</th><th>Client</th><th class="v5-mono num">Frames</th></tr>
      </thead>
      <tbody>
        {
          series.map((s, i) => (
            <tr>
              <td class="v5-mono v5-dim">{String(i + 1).padStart(2, '0')}</td>
              <td><a href={href('v5', `/work/${s.slug}`)}>{s.title}</a></td>
              <td class="v5-mono">{s.year}</td>
              <td>{DISCIPLINE_LABEL[s.discipline]}</td>
              <td>{s.location ?? ''}</td>
              <td>{s.client ?? ''}</td>
              <td class="v5-mono num">{s.images.length}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Shell>
