---
import Shell from '@/versions/v4/Shell.astro';
import Frame from '@/versions/v4/Frame.astro';
import Pic from '@/components/Pic.astro';
import { getSite, neighbours } from '@/lib/cms';
import { heightSizes, ogImageUrl, preloadAttrs } from '@/lib/image';
import { seriesLd } from '@/lib/jsonld';
import { rows } from '@/lib/layout';
import { toHtml, toText, words } from '@/lib/portable';
import { href } from '@/lib/site';
import { DISCIPLINE_LABEL } from '@/lib/types';

export async function getStaticPaths() {
  const { series } = await getSite();
  return series.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}
const { settings, series } = await getSite();
const item = series.find((s) => s.slug === Astro.props.slug)!;
const { next } = neighbours(series, item);
const list = rows(item.images);
const first = item.images[0];
const firstSizes = first.displayWidth === 'full' ? '100vw' : heightSizes(first, 88, 86);
const description = words(toText(item.intro), 30) || `${item.title}, ${item.year}. ${DISCIPLINE_LABEL[item.discipline]} by ${settings.photographerName}.`;
---

<Shell {settings} title={item.title} {description} type="article" image={ogImageUrl(item.cover)} preload={preloadAttrs(first, firstSizes)} jsonLd={[seriesLd(item, settings, Astro.site, Astro.url.toString())]} corner={`${item.title}, ${item.year}`} frames={list.length}>
  <h1 class="sr-only">{item.title}</h1>
  <div class="reel">
    {
      list.map((row, i) =>
        row.kind === 'pair' ? (
          <section class="cine cine--pair" data-frame={i} aria-label={`Frame ${i + 1}`}>
            {row.photos.map((p) => <Pic photo={p} sizes={heightSizes(p, 88, 42)} class="cine__pic" />)}
            <dl class="cine__info">
              <dt>Description</dt><dd>{row.photos.map((p) => p.alt).join('; ')}</dd>
              {row.photos.some((p) => p.caption) && (<><dt>Caption</dt><dd class="cine__caption">{row.photos.map((p) => p.caption).filter(Boolean).join('; ')}</dd></>)}
              <dt>Frame</dt><dd>{i + 1}</dd>
            </dl>
          </section>
        ) : (
          <Frame photo={row.photo} index={i} series={item} priority={i === 0} />
        ),
      )
    }
    <section class="cine cine--text" aria-label="End">
      <div class="v4-prose v4-meta" set:html={toHtml(item.intro)} />
      {next && (<><p class="v4-small v4-meta">Next</p><a class="v4-display" href={href('v4', `/work/${next.slug}`)}>{next.title}</a></>)}
    </section>
  </div>
</Shell>
