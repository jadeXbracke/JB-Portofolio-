---
import Shell from '@/versions/v3/Shell.astro';
import Pic from '@/components/Pic.astro';
import { getSite, heroPhoto } from '@/lib/cms';
import { href } from '@/lib/site';
const { settings, homepage } = await getSite();
const photo = heroPhoto(homepage)!;
const SIZES = '(min-width: 60em) 70vw, 100vw';
---

<Shell {settings} title="Not found" description="That page does not exist." noindex>
  <Fragment slot="panel">
    <h1 class="v3-display">Not found</h1>
    <p>That page does not exist. <a href={href('v3', '/work')}>Work</a></p>
  </Fragment>
  <Pic photo={photo} sizes={SIZES} fill />
</Shell>
