---
import Shell from '@/site/Shell.astro';
import Grid from '@/site/Grid.astro';
import Viewer from '@/site/Viewer.astro';
import { getArchive, getSite } from '@/lib/cms';
import { heightSizes, ogImageUrl, preloadAttrs, QUALITY } from '@/lib/image';
import { personLd } from '@/lib/jsonld';

const { settings, series } = await getSite();
const items = await getArchive();
const first = items[0]?.photo;
---

<Shell
  {settings}
  {series}
  title={settings.seoDefaults.title}
  description={settings.seoDefaults.description}
  image={ogImageUrl(settings.seoDefaults.ogImage ?? first)}
  preload={first ? preloadAttrs(first, heightSizes(first, 30, 90), QUALITY.grid) : undefined}
  jsonLd={[personLd(settings, Astro.site, Astro.url.toString())]}
  left={[{ label: `${items.length} images` }, { label: 'Index', href: '/work' }]}
>
  <h1 class="sr-only">{settings.photographerName}</h1>
  <Grid {items} />
  <Viewer />
</Shell>
