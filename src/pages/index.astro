---
import Shell from '@/site/Shell.astro';
import Cinema from '@/site/Cinema.astro';
import { getSite } from '@/lib/cms';
import { heightSizes, ogImageUrl, preloadAttrs, QUALITY } from '@/lib/image';
import { personLd } from '@/lib/jsonld';

const { settings, series, homepage } = await getSite();
const items = homepage.selectedWork;
const first = items[0]?.cover;
---

<Shell
  {settings}
  {series}
  title={settings.seoDefaults.title}
  description={settings.seoDefaults.description}
  image={ogImageUrl(settings.seoDefaults.ogImage ?? first)}
  preload={first ? preloadAttrs(first, heightSizes(first, 88, 92), QUALITY.single) : undefined}
  jsonLd={[personLd(settings, Astro.site, Astro.url.toString())]}
  left={[{ label: 'Archive', href: '/', current: true }, { label: 'Work', href: '/work' }]}
>
  <h1 class="sr-only">{settings.photographerName}</h1>
  <Cinema {items} />
</Shell>
