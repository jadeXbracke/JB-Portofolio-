---
import Shell from '@/versions/v2/Shell.astro';
import Pic from '@/components/Pic.astro';
import { getSite, neighbours } from '@/lib/cms';
import { heightSizes, ogImageUrl, preloadAttrs } from '@/lib/image';
import { seriesLd } from '@/lib/jsonld';
import { rows } from '@/lib/layout';
import { toHtml, toText, words } from '@/lib/portable';
import { href } from '@/lib/site';
import { DISCIPLINE_LABEL, type DisplayWidth } from '@/lib/types';

export async function getStaticPaths() {
  const { series } = await getSite();
  return series.map((s) => ({ params: { slug: s.slug }, props: { slug: s.slug } }));
}
const { settings, series } = await getSite();
const item = series.find((s) => s.slug === Astro.props.slug)!;
const { next } = neighbours(series, item);
const VH: Record<DisplayWidth, number> = { full: 82, wide: 64, half: 48, column: 36 };
const first = item.images[0];
const description = words(toText(item.intro), 30) || `${item.title}, ${item.year}. ${DISCIPLINE_LABEL[item.discipline]} by ${settings.photographerName}.`;
---

<Shell {settings} title={item.title} {description} type="article" image={ogImageUrl(item.cover)} preload={first ? preloadAttrs(first, heightSizes(first, VH[first.displayWidth])) : undefined} jsonLd={[seriesLd(item, settings, Astro.site, Astro.url.toString())]}>
  <article>
    <header class="sheet__head">
      <h1 class="v2-caps">{item.title}</h1>
      <dl class="sheet__meta v2-small v2-muted">
        <dt>Year</dt><dd>{item.year}</dd>
        <dt>Discipline</dt><dd>{DISCIPLINE_LABEL[item.discipline]}</dd>
        {item.location && (<><dt>Location</dt><dd>{item.location}</dd></>)}
        {item.client && (<><dt>Client</dt><dd>For {item.client}</dd></>)}
      </dl>
      <div class="sheet__intro v2-prose" set:html={toHtml(item.intro)} />
    </header>
    {
      rows(item.images).map((row, i) =>
        row.kind === 'pair' ? (
          <div class="frame frame--pair">
            {row.photos.map((p) => (
              <>
                <Pic photo={p} sizes={heightSizes(p, 48, 44)} class="frame__pic" priority={i === 0} />
              </>
            ))}
            {row.photos.some((p) => p.caption) && (
              <p class="frame__caption" style="grid-column: 1 / -1">{row.photos.map((p) => p.caption).filter(Boolean).join(' / ')}</p>
            )}
          </div>
        ) : (
          <figure class:list={['frame', `frame--${row.photo.displayWidth}`]}>
            <Pic photo={row.photo} sizes={heightSizes(row.photo, VH[row.photo.displayWidth])} class="frame__pic" priority={i === 0} />
            {row.photo.caption && <figcaption class="frame__caption">{row.photo.caption}</figcaption>}
          </figure>
        ),
      )
    }
    {
      next && (
        <footer class="sheet__next">
          <p class="v2-small v2-muted">Next</p>
          <a href={href('v2', `/work/${next.slug}`)} class="v2-caps">{next.title}</a>
        </footer>
      )
    }
  </article>
</Shell>
