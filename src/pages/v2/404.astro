---
import Shell from '@/versions/v2/Shell.astro';
import { getSite } from '@/lib/cms';
import { href } from '@/lib/site';
const { settings } = await getSite();
---

<Shell {settings} title="Not found" description="That page does not exist." noindex>
  <section class="v2-page">
    <h1 class="v2-caps">Not found</h1>
    <p class="v2-muted">That page does not exist. <a href={href('v2', '/work')}>Work</a></p>
  </section>
</Shell>
