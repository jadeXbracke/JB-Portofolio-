---
import Shell from '@/versions/v2/Shell.astro';
import { getSite } from '@/lib/cms';
import { ogImageUrl } from '@/lib/image';
import { personLd } from '@/lib/jsonld';
const { settings } = await getSite();
---

<Shell {settings} title="Contact" description={`Commission ${settings.photographerName}: ${settings.email}. ${settings.availabilityNote ?? ''}`.trim()} image={ogImageUrl(settings.seoDefaults.ogImage)} jsonLd={[personLd(settings, Astro.site, Astro.url.toString())]}>
  <section class="v2-page">
    <h1 class="v2-small v2-muted">Commissions, prints, questions</h1>
    <a class="v2-email" href={`mailto:${settings.email}`}>{settings.email}</a>
    <address class="v2-links v2-small">
      {settings.phone && <a href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a>}
      {settings.instagram && <a href={`https://www.instagram.com/${settings.instagram}/`} rel="me">@{settings.instagram}</a>}
    </address>
    {settings.availabilityNote && <p class="v2-muted">{settings.availabilityNote}</p>}
  </section>
</Shell>
