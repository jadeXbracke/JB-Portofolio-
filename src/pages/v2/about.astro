---
import Shell from '@/versions/v2/Shell.astro';
import Pic from '@/components/Pic.astro';
import { getSite } from '@/lib/cms';
import { heightSizes, ogImageUrl, preloadAttrs } from '@/lib/image';
import { personLd } from '@/lib/jsonld';
import { toHtml, toText, words } from '@/lib/portable';

const { settings } = await getSite();
const p = settings.portrait;
---

<Shell {settings} title="About" description={words(toText(settings.aboutBody), 30)} image={ogImageUrl(p ?? settings.seoDefaults.ogImage)} preload={p ? preloadAttrs(p, heightSizes(p, 48)) : undefined} jsonLd={[personLd(settings, Astro.site, Astro.url.toString())]}>
  <section class="v2-page">
    <h1 class="v2-caps">{settings.photographerName}</h1>
    {p && <div class="frame frame--half" style="min-height:0;padding:0"><Pic photo={p} sizes={heightSizes(p, 48)} class="frame__pic" priority /></div>}
    <div class="v2-prose" set:html={toHtml(settings.aboutBody)} />
    {
      settings.cvItems.length > 0 && (
        <ol class="v2-list" aria-label="Selected">
          {settings.cvItems.map((c) => (
            <li>
              <span class="v2-muted">{c.year}</span>
              <span>{c.text}</span>
            </li>
          ))}
        </ol>
      )
    }
    {settings.clientList.length > 0 && <p class="v2-prose v2-muted">{settings.clientList.join(', ')}</p>}
  </section>
</Shell>
