---
import Shell from '@/versions/v1/Shell.astro';
import { getSite } from '@/lib/cms';
import { href } from '@/lib/site';
const { settings } = await getSite();
---

<Shell {settings} title="Not found" description="That page does not exist." noindex>
  <section class="contact">
    <h1 class="v1-display v1-display--l">Not found</h1>
    <p class="contact__note">That page does not exist. <a href={href('v1', '/work')}>Contents</a></p>
  </section>
</Shell>
