---
import Shell from '@/versions/v1/Shell.astro';
import { getSite } from '@/lib/cms';
import { ogImageUrl } from '@/lib/image';
import { personLd } from '@/lib/jsonld';

const { settings } = await getSite();
---

<Shell
  {settings}
  title="Contact"
  description={`Commission ${settings.photographerName}: ${settings.email}. ${settings.availabilityNote ?? ''}`.trim()}
  image={ogImageUrl(settings.seoDefaults.ogImage)}
  jsonLd={[personLd(settings, Astro.site, Astro.url.toString())]}
>
  <section class="contact">
    <h1 class="v1-small">Commissions, prints, questions</h1>
    <a class="contact__email" href={`mailto:${settings.email}`}>{settings.email}</a>
    <address class="contact__links">
      {settings.phone && <a href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a>}
      {settings.instagram && <a href={`https://www.instagram.com/${settings.instagram}/`} rel="me">@{settings.instagram}</a>}
    </address>
    {settings.availabilityNote && <p class="contact__note">{settings.availabilityNote}</p>}
  </section>
</Shell>
