# Copy to .env and fill in. Nothing here is secret except the write token.

# From https://www.sanity.io/manage — the project id looks like "ab12cd34".
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed by `npm run seed:upload` (one-off). Create a token with Editor rights in
# Sanity Manage → API → Tokens. Never commit it.
SANITY_WRITE_TOKEN=

# The public URL of the site. Used for canonical links, sitemap and Open Graph.
SITE_URL=https://jadebracke.com
